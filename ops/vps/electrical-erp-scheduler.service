[Unit]
Description=Electrical ERP scheduled work
After=postgresql.service

[Service]
Type=oneshot
User=electrical-erp
Group=electrical-erp
WorkingDirectory=/srv/electrical-erp/current
ExecStart=/usr/bin/php artisan schedule:run --no-interaction
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/electrical-erp/shared/storage /srv/electrical-erp/current/bootstrap/cache
