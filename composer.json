{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "erp/electrical",
    "type": "project",
    "description": "Electrical ERP modular monolith \u2014 Laravel, Livewire and Flux.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-bcmath": "*",
        "ext-pdo_pgsql": "*",
        "laravel/fortify": "^1.37.2",
        "laravel/framework": "^13.17",
        "laravel/pulse": "^1.0",
        "laravel/tinker": "^3.0",
        "livewire/flux": "^2.13.1",
        "livewire/livewire": "^4.1",
        "maatwebsite/excel": "^4.0",
        "mpdf/mpdf": "^8.3",
        "predis/predis": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "fruitcake/laravel-debugbar": "^4.0",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "phpunit/phpunit": "^12.5.23"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd\" \"php artisan serve --host=127.0.0.1 --port=8000\" \"npm run dev\" --kill-others"
        ],
        "lint": [
            "pint"
        ],
        "lint:check": [
            "pint --test"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "@test"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
